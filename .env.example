# Copy to .env and fill in. .env is gitignored.

# Anthropic API key. Without it the app still runs, using a rule-based offline mode.
ANTHROPIC_API_KEY=

# Claude model used to read each message and phrase each reply.
ANTHROPIC_MODEL=claude-sonnet-5

# demo pins the business date to 2026-03-01 (policies/defaults.toml) so the appeal
# deadlines in the fixtures are still open. production uses the real date.
APP_MODE=demo

# Demo mode only: YYYY-MM-DD or "today". Leave empty for the pinned demo date.
BUSINESS_DATE_OVERRIDE=
