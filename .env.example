# Copy to .env and fill in there. .env is gitignored; never put a real key in this file,
# because this one is committed.

# Set ONE model API key. With neither, the app still runs in a rule-based offline mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: which provider to use when both keys are set (openai, anthropic, or offline).
LLM_PROVIDER=

# Optional model overrides.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-5

# demo pins the business date to 2026-03-01 (policies/defaults.toml) so the appeal
# deadlines in the fixtures are still open. production uses the real date.
APP_MODE=demo

# Demo mode only: YYYY-MM-DD or "today". Leave empty for the pinned demo date.
BUSINESS_DATE_OVERRIDE=
